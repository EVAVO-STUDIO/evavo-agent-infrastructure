{
  "mcpServers": {
    "evavo-local-agent-executor": {
      "command": "node",
      "args": ["./mcp-server/local-agent-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "agent-infrastructure-authority",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-windows-chat-execution": {
      "command": "node",
      "args": ["./mcp-server/windows-chat-execution-mcp.mjs"],
      "env": {
        "EVAVO_WINDOWS_CHAT_EXECUTION_ENABLED": "enabled",
        "EVAVO_WINDOWS_CHAT_EXECUTION_AUTO_RECOVER": "enabled",
        "EVAVO_WINDOWS_CHAT_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads",
        "EVAVO_LOCAL_STORAGE_ROOT": "C:\\GitRepos\\evavo-local-storage",
        "EVAVO_SERVICE_CONTROL_PLANE_ROOT": "C:\\GitRepos\\evavo-service-control-plane"
      }
    },
    "evavo-android-device": {
      "command": "node",
      "args": ["./mcp-server/android-device-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-device-specialist",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-android-app": {
      "command": "node",
      "args": ["./mcp-server/android-app-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-app-runtime",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-android-observer": {
      "command": "node",
      "args": ["./mcp-server/android-observer-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-read-only-observer"
      }
    },
    "evavo-glasses-android": {
      "command": "node",
      "args": ["./mcp-server/glasses-android-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "glasses-android-specialist",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-glasses-tab-a": {
      "command": "node",
      "args": ["./mcp-server/glasses-tab-a-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "glasses-tab-a-durable-acceptance"
      }
    },
    "evavo-godot-android-physical": {
      "command": "node",
      "args": ["./mcp-server/godot-android-physical-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "godot-android-physical-qa",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    }
  }
}
