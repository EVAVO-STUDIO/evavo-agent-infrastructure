{
  "mcpServers": {
    "evavo-local-agent-executor": {
      "command": "node",
      "args": ["./mcp-server/local-agent-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "agent-infrastructure-authority",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-control-policy": {
      "command": "node",
      "args": ["./mcp-server/control-policy-mcp.mjs"],
      "env": {
        "EVAVO_CONTROL_POLICY_MCP_ROLE": "read-only-route-planner"
      }
    },
    "evavo-windows-receipt-inspector": {
      "command": "node",
      "args": ["./mcp-server/windows-receipt-inspector-mcp.mjs"],
      "env": {
        "EVAVO_WINDOWS_RECEIPT_INSPECTOR_ROLE": "read-only-physical-receipt-reconciliation"
      }
    },
    "evavo-hardware-gateway": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "../evavo-local-ai-agent-gateway/scripts/start-mcp.ps1"
      ],
      "env": {
        "EVAVO_HARDWARE_GATEWAY_MCP_ROLE": "governed-physical-control"
      }
    },
    "evavo-windows-workstation-bridge": {
      "command": "../evavo-local-compute/.venv/Scripts/evavo-windows-workstation-bridge.exe",
      "args": ["mcp"],
      "env": {
        "EVAVO_WORKSTATION_BRIDGE_STATE_ROOT": "%LOCALAPPDATA%\\EVAVO\\WindowsWorkstationBridge",
        "EVAVO_LOCAL_EXECUTION_PREPARE_ENABLED": "enabled",
        "EVAVO_LOCAL_EXECUTION_MCP_ENABLED": "enabled",
        "EVAVO_LOCAL_EXECUTION_ENABLED": "enabled",
        "EVAVO_LOCAL_NETWORK_ENABLED": "disabled",
        "EVAVO_LOCAL_SCRIPT_EXECUTION_ENABLED": "enabled",
        "EVAVO_LOCAL_REPOSITORY_CODE_ENABLED": "enabled",
        "EVAVO_LOCAL_FILESYSTEM_WRITE_ENABLED": "enabled",
        "EVAVO_LOCAL_GIT_MUTATION_ENABLED": "enabled",
        "EVAVO_LOCAL_CONTAINER_ENABLED": "disabled",
        "EVAVO_LOCAL_ARCHIVE_ENABLED": "disabled",
        "EVAVO_LOCAL_EXECUTION_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads",
        "EVAVO_COMPUTE_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads"
      }
    },
    "evavo-windows-workstation-operator": {
      "command": "../evavo-local-compute/.venv/Scripts/evavo-windows-workstation-bridge.exe",
      "args": ["mcp"],
      "env": {
        "EVAVO_WORKSTATION_BRIDGE_STATE_ROOT": "%LOCALAPPDATA%\\EVAVO\\WindowsWorkstationBridge",
        "EVAVO_LOCAL_EXECUTION_PREPARE_ENABLED": "enabled",
        "EVAVO_LOCAL_EXECUTION_MCP_ENABLED": "enabled",
        "EVAVO_LOCAL_EXECUTION_ENABLED": "enabled",
        "EVAVO_LOCAL_NETWORK_ENABLED": "enabled",
        "EVAVO_LOCAL_SCRIPT_EXECUTION_ENABLED": "enabled",
        "EVAVO_LOCAL_REPOSITORY_CODE_ENABLED": "enabled",
        "EVAVO_LOCAL_FILESYSTEM_WRITE_ENABLED": "enabled",
        "EVAVO_LOCAL_GIT_MUTATION_ENABLED": "enabled",
        "EVAVO_LOCAL_CONTAINER_ENABLED": "disabled",
        "EVAVO_LOCAL_ARCHIVE_ENABLED": "enabled",
        "EVAVO_LOCAL_EXECUTION_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads",
        "EVAVO_COMPUTE_ALLOWED_ROOTS": "C:\\GitRepos;%LOCALAPPDATA%\\EVAVO;%USERPROFILE%\\Downloads",
        "EVAVO_WINDOWS_OPERATOR_PROFILE": "enabled"
      }
    },
    "evavo-windows-execution-migration-guide": {
      "command": "node",
      "args": ["./mcp-server/windows-chat-execution-mcp.mjs"],
      "env": {
        "EVAVO_AGENT_WORKSTATION_EXECUTION_PROVIDER": "evavo-hardware-gateway",
        "EVAVO_AGENT_WORKSTATION_EXECUTION_FALLBACK": "evavo-windows-workstation-bridge",
        "EVAVO_AGENT_WORKSTATION_EXECUTION_STATUS": "legacy-raw-shell-retired"
      }
    },
    "evavo-storage-governance": {
      "command": "node",
      "args": ["./mcp-server/windows-storage-governance-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_STORAGE_ROOT": "C:\\GitRepos\\evavo-local-storage"
      }
    },
    "evavo-windows-physical-control-status": {
      "command": "node",
      "args": ["./mcp-server/windows-physical-control-status-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_COMPUTE_ROOT": "C:\\GitRepos\\evavo-local-compute",
        "EVAVO_LOCAL_STORAGE_ROOT": "C:\\GitRepos\\evavo-local-storage"
      }
    },
    "evavo-android-device": {
      "command": "node",
      "args": ["./mcp-server/android-device-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-device-specialist",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-android-app": {
      "command": "node",
      "args": ["./mcp-server/android-app-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-app-runtime",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-android-observer": {
      "command": "node",
      "args": ["./mcp-server/android-observer-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "android-read-only-observer"
      }
    },
    "evavo-glasses-android": {
      "command": "node",
      "args": ["./mcp-server/glasses-android-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "glasses-android-specialist",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    },
    "evavo-glasses-tab-a": {
      "command": "node",
      "args": ["./mcp-server/glasses-tab-a-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "glasses-tab-a-durable-acceptance"
      }
    },
    "evavo-godot-android-physical": {
      "command": "node",
      "args": ["./mcp-server/godot-android-physical-mcp.mjs"],
      "env": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "godot-android-physical-qa",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-agent-mcp"
      }
    }
  }
}
