{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVAVO Documentation Truth Runtime Activation Grant Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "accepted",
    "leaseAcquired",
    "modelTurnPerformed",
    "queueMutationPerformed",
    "repositoryMutationPerformed",
    "commitPerformed",
    "pushPerformed",
    "publicationPerformed",
    "deploymentPerformed",
    "financialActionPerformed",
    "paidFallbackUsed",
    "privateKeyAccessed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "evavo-documentation-truth-runtime-activation-grant-verification-v1" },
    "accepted": { "type": "boolean" },
    "verifiedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "grantId": { "type": "string", "pattern": "^doc-truth:[0-9a-f]{40}$" },
    "grantBodySha256": { "$ref": "#/$defs/sha256" },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "requestBytesSha256": { "$ref": "#/$defs/sha256" },
    "envelopeBytesSha256": { "$ref": "#/$defs/sha256" },
    "trustAnchorBytesSha256": { "$ref": "#/$defs/sha256" },
    "trustAnchorKeyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "consumedUses": { "type": "integer", "minimum": 0, "maximum": 0 },
    "remainingUses": { "const": 1 },
    "maximumConcurrency": { "const": 1 },
    "workerClass": { "const": "documentation-truth" },
    "workClass": { "const": "capability-manifest-maintenance" },
    "routeId": { "const": "codex-spark-pro" },
    "capacityClass": { "const": "included-consumer" },
    "agentInfrastructureMainSha": { "$ref": "#/$defs/gitSha" },
    "localStorageMainSha": { "$ref": "#/$defs/gitSha" },
    "candidateAcceptanceSha256": { "$ref": "#/$defs/sha256" },
    "crossRepositoryDesignSha256": { "$ref": "#/$defs/sha256" },
    "workItemId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "workItemSha256": { "$ref": "#/$defs/sha256" },
    "targetRepository": { "type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]{1,100}$" },
    "targetSourceRevision": { "$ref": "#/$defs/gitSha" },
    "leaseAcquired": { "const": false },
    "modelTurnPerformed": { "const": false },
    "queueMutationPerformed": { "const": false },
    "repositoryMutationPerformed": { "const": false },
    "commitPerformed": { "const": false },
    "pushPerformed": { "const": false },
    "publicationPerformed": { "const": false },
    "deploymentPerformed": { "const": false },
    "financialActionPerformed": { "const": false },
    "paidFallbackUsed": { "const": false },
    "privateKeyAccessed": { "const": false },
    "truthBoundary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "verificationSha256": { "$ref": "#/$defs/sha256" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  },
  "oneOf": [
    {
      "properties": { "accepted": { "const": true } },
      "required": [
        "verifiedAt",
        "grantId",
        "grantBodySha256",
        "requestSha256",
        "requestBytesSha256",
        "envelopeBytesSha256",
        "trustAnchorBytesSha256",
        "trustAnchorKeyId",
        "expiresAt",
        "consumedUses",
        "remainingUses",
        "maximumConcurrency",
        "workerClass",
        "workClass",
        "routeId",
        "capacityClass",
        "agentInfrastructureMainSha",
        "localStorageMainSha",
        "candidateAcceptanceSha256",
        "crossRepositoryDesignSha256",
        "workItemId",
        "workItemSha256",
        "targetRepository",
        "targetSourceRevision",
        "truthBoundary",
        "verificationSha256"
      ],
      "not": { "required": ["errors"] }
    },
    {
      "properties": { "accepted": { "const": false } },
      "required": ["errors"]
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
