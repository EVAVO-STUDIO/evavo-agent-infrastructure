{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVAVO Codex Documentation Truth Fixture Supervision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "fixtureId",
    "workerClass",
    "workClass",
    "routeId",
    "modelPreference",
    "codexVersion",
    "evidenceSha256",
    "fixtureOnly",
    "fixtureRepositoryRemoteCount",
    "fixturePrimaryCheckoutClean",
    "fixtureMainUnchanged",
    "candidateCleanupComplete",
    "registeredWorktreesAfterCleanup",
    "normalRouteWasUnchanged",
    "workerCommitPerformed",
    "commitPerformed",
    "pushPerformed",
    "publicationPerformed",
    "deploymentPerformed",
    "paidFallbackUsed",
    "financialActionPerformed",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "evavo-codex-documentation-truth-fixture-supervision-v1" },
    "fixtureId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workerClass": { "const": "documentation-truth" },
    "workClass": { "const": "capability-manifest-maintenance" },
    "routeId": { "const": "codex-spark-pro" },
    "modelPreference": { "const": "gpt-5.3-codex-spark" },
    "codexVersion": { "type": "string", "minLength": 1, "maxLength": 160 },
    "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureOnly": { "const": true },
    "fixtureRepositoryRemoteCount": { "const": 0 },
    "fixturePrimaryCheckoutClean": { "const": true },
    "fixtureMainUnchanged": { "const": true },
    "candidateCleanupComplete": { "const": true },
    "registeredWorktreesAfterCleanup": { "const": 1 },
    "normalRouteWasUnchanged": { "const": true },
    "workerCommitPerformed": { "const": false },
    "commitPerformed": { "const": false },
    "pushPerformed": { "const": false },
    "publicationPerformed": { "const": false },
    "deploymentPerformed": { "const": false },
    "paidFallbackUsed": { "const": false },
    "financialActionPerformed": { "const": false },
    "receiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
