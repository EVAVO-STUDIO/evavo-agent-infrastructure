{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVAVO Documentation Truth Runtime Capacity Admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "eligible",
    "decision",
    "routeId",
    "modelPreference",
    "capacityClass",
    "rawCapacityState",
    "admittedWorkerClasses",
    "maximumConcurrency",
    "agentInfrastructureMainSha",
    "localStorageMainSha",
    "candidateAcceptanceSha256",
    "crossRepositoryDesignSha256",
    "grantId",
    "grantBodySha256",
    "requestSha256",
    "workItemId",
    "workItemSha256",
    "repository",
    "sourceRevision",
    "capacityStatusSha256",
    "physicalAcceptanceSha256",
    "observedAt",
    "expiresAt",
    "physicalAcceptanceAccepted",
    "candidateCampaignAccepted",
    "signedRuntimeGrantRequired",
    "paidFallbackAllowed",
    "executionPerformed",
    "queueMutationPerformed",
    "leaseAcquired",
    "modelTurnPerformed",
    "repositoryMutationPerformed",
    "publicationPerformed",
    "admissionSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "evavo-documentation-truth-runtime-capacity-admission-v1" },
    "eligible": { "const": true },
    "decision": { "const": "ADMITTED" },
    "routeId": { "const": "codex-spark-pro" },
    "modelPreference": { "const": "gpt-5.3-codex-spark" },
    "capacityClass": { "const": "included-consumer" },
    "rawCapacityState": { "enum": ["AVAILABLE", "DEGRADED"] },
    "admittedWorkerClasses": {
      "type": "array",
      "prefixItems": [{ "const": "documentation-truth" }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "maximumConcurrency": { "const": 1 },
    "agentInfrastructureMainSha": { "$ref": "#/$defs/gitSha" },
    "localStorageMainSha": { "$ref": "#/$defs/gitSha" },
    "candidateAcceptanceSha256": { "$ref": "#/$defs/sha256" },
    "crossRepositoryDesignSha256": { "$ref": "#/$defs/sha256" },
    "grantId": { "type": "string", "pattern": "^doc-truth:[0-9a-f]{40}$" },
    "grantBodySha256": { "$ref": "#/$defs/sha256" },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "workItemId": { "$ref": "#/$defs/id" },
    "workItemSha256": { "$ref": "#/$defs/sha256" },
    "repository": { "$ref": "#/$defs/repository" },
    "sourceRevision": { "$ref": "#/$defs/gitSha" },
    "capacityStatusSha256": { "$ref": "#/$defs/sha256" },
    "physicalAcceptanceSha256": { "$ref": "#/$defs/sha256" },
    "observedAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "expiresAt": { "type": "string", "format": "date-time", "maxLength": 64 },
    "physicalAcceptanceAccepted": { "const": true },
    "candidateCampaignAccepted": { "const": true },
    "signedRuntimeGrantRequired": { "const": true },
    "paidFallbackAllowed": { "const": false },
    "executionPerformed": { "const": false },
    "queueMutationPerformed": { "const": false },
    "leaseAcquired": { "const": false },
    "modelTurnPerformed": { "const": false },
    "repositoryMutationPerformed": { "const": false },
    "publicationPerformed": { "const": false },
    "admissionSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": { "type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]{1,100}$" }
  }
}
