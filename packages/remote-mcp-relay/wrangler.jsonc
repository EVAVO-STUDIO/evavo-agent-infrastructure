{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evavo-workstation-mcp-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSTATION_RELAY", "class_name": "WorkstationRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkstationRelay"] }
  ],
  "observability": { "enabled": true }
}
