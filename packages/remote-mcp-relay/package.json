{
  "name": "@evavo/remote-mcp-relay",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare-hosted read-only MCP status surface and authenticated outbound workstation relay for EVAVO.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "type-check": "wrangler types && tsc --noEmit",
