    "test": "node --test test/*.test.mjs",
    "check": "npm run test && npm run type-check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "wrangler": "^4.30.0"
  }
}
