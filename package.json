{
  "name": "evavo-agent-infrastructure",
  "version": "1.2.2",
  "description": "Comprehensive agent infrastructure for EVAVO ecosystem - code, test, build, deploy, review",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp-server",
    "cli-tool"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:capability-routing": "node --test tests/agent-capability-routing.test.mjs",
    "test:github-estate-routing": "node --test tests/github-estate-routing-integrity.test.mjs tests/github-estate-routing-policy.test.mjs",
    "check:capability-routing": "node scripts/check-agent-capability-routing.mjs",
    "plan:capability-routing": "node scripts/plan-agent-capability-route.mjs",
    "route:github-estate": "node scripts/route-github-estate-snapshot.mjs",
    "test:windows-chat-mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoWindowsChatExecutionMcpContract.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoWindowsChatExecutionMcpHandshake.ps1",
    "test:windows-chat-physical": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoWindowsChatExecutionMcpPhysical.ps1",
    "test:chatgpt-windows-execution-tunnel-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoChatGPTWindowsExecutionTunnelContract.ps1",
    "test:android-mcps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoAndroidDeviceMcp.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoAndroidSpecialistMcps.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoGlassesTabAMcpContract.ps1",
    "test:physical-device-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoPhysicalDeviceAgentAccessContract.ps1",
    "test:chatgpt-android-observer-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoChatGPTAndroidObserverTunnelContract.ps1",
    "test:chatgpt-workstation-observer-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoChatGPTWorkstationObserverTunnelContract.ps1",
    "test:remote-access-install-contract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoRemoteWorkstationAccessInstallContract.ps1",
    "test:remote-mcp-relay-contract": "node --test packages/remote-mcp-relay/test/relay-contract.test.mjs",
    "test:provider-credential-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoProviderCredentialReadiness.ps1",
    "test:android-physical": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoAndroidPhysicalBringup.ps1",
    "test:local-agent-mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoLocalAgentMcp043.ps1",
    "test:storage-governance-mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoWindowsStorageGovernanceMcpContract.ps1",
    "chat:local-agent:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Ensure-EvavoChatLocalAgent.ps1 -Json",
    "chat:local-agent:ensure-operator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Ensure-EvavoChatLocalAgent.ps1 -IncludeOperatorExecution -Json",
    "physical-device:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoPhysicalDeviceAgentAccess.ps1 -Json",
    "physical-device:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-EvavoPhysicalDeviceAgentAccess.ps1 -Json",
    "chatgpt:android-observer-tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoChatGPTAndroidObserverTunnel.ps1 -StartNow -Json",
    "chatgpt:workstation-observer-tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoChatGPTWorkstationObserverTunnelV3.ps1 -StartNow -Json",
    "chatgpt:windows-execution-tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoChatGPTWindowsExecutionTunnel.ps1 -StartNow -Json",
    "chatgpt:windows-execution-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoChatGPTWindowsExecutionTunnelStatus.ps1 -ProbeTunnelDoctor",
    "chatgpt:workstation-observer-tunnel-v2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoChatGPTWorkstationObserverTunnelV2.ps1 -StartNow -Json",
    "chatgpt:workstation-observer-tunnel-v1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoChatGPTWorkstationObserverTunnel.ps1 -StartNow -Json",
    "chatgpt:workstation-observer-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoChatGPTWorkstationObserverTunnelStatus.ps1",
    "provider-credentials:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoProviderCredentialReadiness.ps1",
    "provider-credentials:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoProviderCredentialReadiness.ps1 -ProbeCliAuth",
    "remote-access:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoRemoteWorkstationAccess.ps1 -StartNow -Json",
    "remote-access:install-with-execution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoRemoteWorkstationAccess.ps1 -EnableWindowsExecution -StartNow -Json",
    "remote-access:install-with-execution-and-cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoRemoteWorkstationAccess.ps1 -EnableWindowsExecution -ProvisionCloudflareRelay -StartNow -Json",
    "remote-access:install-with-cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-EvavoRemoteWorkstationAccess.ps1 -StartNow -ProvisionCloudflareRelay -Json",
    "remote-access:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoRemoteWorkstationAccessStatus.ps1",
    "remote-access:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Get-EvavoRemoteWorkstationAccessStatus.ps1 -ProbeOpenAiTunnelDoctor -ProbeRestHealth -ProbeProviderCliAuth",
    "remote-mcp-relay:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Deploy-EvavoRemoteMcpRelayV2.ps1",
    "remote-mcp-relay:deploy-v1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Deploy-EvavoRemoteMcpRelay.ps1",
    "check:capability-manifest": "node scripts/check-evavo-capability-manifest.mjs",
    "check": "pnpm check:capability-manifest && pnpm test:spark-governance && pnpm test:capability-routing && pnpm test:github-estate-routing && pnpm check:capability-routing && pnpm test && pnpm test:windows-chat-mcp && pnpm test:chatgpt-windows-execution-tunnel-contract && pnpm test:android-mcps && pnpm test:physical-device-contract && pnpm test:chatgpt-android-observer-contract && pnpm test:chatgpt-workstation-observer-contract && pnpm test:remote-access-install-contract && pnpm test:remote-mcp-relay-contract && pnpm test:storage-governance-mcp && pnpm test:provider-credential-readiness",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "dev": "pnpm -r dev",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "docs:generate": "typedoc --out docs src",
    "check:spark-governance": "node scripts/check-worker-capacity-routing-v1.mjs",
    "check:spark-candidate-observation": "node scripts/check-codex-candidate-observation-contract.mjs",
    "check:spark-ignored-workspace": "node scripts/check-codex-ignored-workspace-boundary-contract.mjs",
    "check:spark-autonomous-lease": "node scripts/check-autonomous-work-exchange-lease-contract.mjs",
    "compile:spark-bound-dispatch": "node scripts/compile-codex-worker-dispatch-bound.mjs",
    "compile:spark-contained-dispatch": "node scripts/compile-codex-worker-dispatch-contained.mjs",
    "run:spark-contained-worker": "node scripts/run-codex-worker-dispatch-contained.mjs",
    "compile:spark-test-builder-completion": "node scripts/compile-codex-test-builder-completion.mjs",
    "compile:spark-contained-completion": "node scripts/compile-codex-test-builder-completion-contained.mjs",
    "compile:documentation-truth-grant-bound-dispatch": "node scripts/compile-codex-documentation-truth-grant-bound-dispatch.mjs",
    "run:documentation-truth-grant-bound-dispatch": "node scripts/run-codex-documentation-truth-grant-bound-dispatch.mjs",
    "test:spark-routing": "node scripts/test-worker-capacity-routing.mjs",
    "test:spark-capacity-status": "node scripts/test-codex-spark-capacity-status.mjs",
    "test:spark-candidate-observer": "node scripts/test-codex-candidate-change-observer.mjs",
    "test:spark-ignored-workspace": "node scripts/test-codex-ignored-workspace-boundary.mjs",
    "test:spark-dispatch-binding": "node scripts/test-codex-worker-dispatch-binding.mjs",
    "test:spark-test-builder-completion": "node scripts/test-codex-test-builder-completion.mjs",
    "test:spark-test-builder-boundary": "node scripts/test-codex-test-builder-boundary.mjs",
    "test:spark-runner-safety": "node scripts/test-codex-worker-runner-safety.mjs",
    "test:spark-result-classifier": "node scripts/test-codex-worker-result-classifier.mjs",
    "test:spark-auth-policy": "node scripts/test-codex-chatgpt-auth-policy.mjs",
    "test:spark-safe-certification": "node scripts/test-codex-spark-safe-certification-contract.mjs && node scripts/test-codex-spark-safe-physical-acceptance.mjs",
    "test:spark-documentation-truth-grant-bound": "node scripts/test-documentation-truth-grant-bound-dispatch.mjs",
    "test:spark-governance": "pnpm check:spark-governance && pnpm check:spark-candidate-observation && pnpm check:spark-ignored-workspace && pnpm test:spark-routing && pnpm test:spark-capacity-status && pnpm test:spark-candidate-observer && pnpm test:spark-ignored-workspace && pnpm test:spark-dispatch-binding && pnpm test:spark-test-builder-completion && pnpm test:spark-test-builder-boundary && pnpm test:spark-runner-safety && pnpm test:spark-result-classifier && pnpm test:spark-auth-policy && pnpm test:spark-safe-certification && pnpm check:spark-autonomous-lease && pnpm test:spark-documentation-truth-grant-bound && pnpm check:spark-documentation-truth-readiness",
    "check:spark-documentation-truth-readiness": "node scripts/check-documentation-truth-contract-compatibility.mjs && node scripts/check-documentation-truth-supervised-fixture-acceptance-v2.mjs && node scripts/check-documentation-truth-supervised-activation-v2.mjs && node scripts/check-documentation-truth-runtime-route-planner-contract.mjs && node scripts/check-documentation-truth-route-bound-lease-v2.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "typedoc": "^0.25.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
