{
  "schemaVersion": 1,
  "kind": "evavo-worker-capacity-routing",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "purpose": "Select an eligible worker/model route only after Development Studio has admitted a bounded work packet and Agent Infrastructure has assembled current capacity plus physical-admission evidence. Dispatch, execution and completion must preserve exact work, route, process and candidate-content identities. This contract creates neither engineering scope nor validation, commit or publication authority.",
  "workerRoutes": [
    {
      "id": "codex-spark-pro",
      "runtime": "codex",
      "modelPreference": "gpt-5.3-codex-spark",
      "workerClasses": [
        "test-generation"
      ],
      "capacityClass": "included-consumer",
      "routineCost": "included-plan-capacity",
      "paidFallbackAllowed": false,
      "maximumAutomaticConcurrency": 1,
      "statusStates": [
        "AVAILABLE",
        "DEGRADED",
        "RATE_LIMITED",
        "EXHAUSTED",
        "AUTH_REQUIRED",
        "OFFLINE"
      ],
      "dispatchPolicy": {
        "requireReadyWorkPacket": true,
        "requireExactSourceRevision": true,
        "requireCanonicalCapacityStatus": true,
        "requireFreshCapacityObservation": true,
        "requireSupervisedPhysicalAdmission": true,
        "requireDigestBoundRouteAdmission": true,
        "requireSameCapabilityReceiptAtDispatch": true,
        "requireExactWorkItemBytes": true,
        "requireBoundDispatchPlan": true,
        "requireExactDispatchBytesAtProcessStart": true,
        "requireExactAllowedPathEnvelope": true,
        "requireExactValidationRequest": true,
        "requireIndependentCandidateObservation": true,
        "requireStableCandidateContentDigest": true,
        "rejectStagedOrUnmergedCandidate": true,
        "freshWorkerPerJob": true,
        "freshWorkerPerRetry": true,
        "maximumAutomaticAttempts": 2,
        "defaultReservePercent": 10,
        "allowReserveDrainNearReset": true,
        "onRateLimit": "backoff-and-retain-ready-job",
        "onExhausted": "retain-ready-job",
        "onMissingAdmission": "retain-ready-job",
        "onAdmissionDrift": "reject-dispatch-and-reassemble-status",
        "onCandidateIdentityDrift": "reject-completion-and-reobserve-candidate",
        "onArchitectureUncertainty": "NEEDS_DEEP_WORKER",
        "runDeterministicValidationInsideModelSession": false
      },
      "truthBoundary": "Codex transport/authentication, raw Spark capacity and supervised physical admission are independent evidence classes. A started model turn is not completion. Completion requires the exact bound dispatch bytes and a stable independent candidate-content digest. Model output never grants deterministic-validation, staging, commit, push or publication authority, and only test-generation at concurrency one is currently physically admitted."
    },
    {
      "id": "local-classification-default",
      "runtime": "local-ai",
      "modelPreference": "model-lab-admitted-local-text",
      "workerClasses": [
        "local-classification"
      ],
      "capacityClass": "local-compute",
      "routineCost": "local-compute",
      "paidFallbackAllowed": false,
      "maximumAutomaticConcurrency": 2
    }
  ],
  "selection": {
    "requiredInputs": [
      "workerClass",
      "capacityClass",
      "paidFallbackAllowed",
      "jobPriority",
      "repository",
      "sourceRevision",
      "canonicalCapacityStatus",
      "routeAdmissionSha256"
    ],
    "factors": [
      "eligibility",
      "qualityFit",
      "rawCapacityState",
      "physicalAdmissionState",
      "workerClassAdmission",
      "admittedConcurrency",
      "costClass",
      "observedSuccessRate",
      "jobPriority"
    ],
    "rule": "Prefer an eligible zero-incremental-cost route that fits the worker class only when current raw capacity and a short-lived supervised physical route admission agree. Never infer admission from availability and never silently convert included-capacity maintenance work into paid API usage."
  },
  "telemetry": {
    "record": [
      "routeId",
      "workerClass",
      "capacityObservationSha256",
      "supervisedAcceptanceSha256",
      "capabilityReceiptSha256",
      "routeAdmissionSha256",
      "workItemBytesSha256",
      "routePlanSha256",
      "dispatchPlanSha256",
      "candidateStateSha256",
      "trackedPatchSha256",
      "candidateFileManifestSha256",
      "startedAt",
      "finishedAt",
      "resultState",
      "rateLimitObserved",
      "validationOutcome",
      "reviewOutcome"
    ],
    "useForRouting": [
      "rollingSuccessRateByWorkerClass",
      "rollingRejectionRate",
      "rollingRegressionRate",
      "rateLimitFrequency",
      "meanJobDuration"
    ]
  }
}
