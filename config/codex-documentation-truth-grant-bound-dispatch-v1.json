{
  "schemaVersion": 1,
  "kind": "evavo-codex-documentation-truth-grant-bound-dispatch-policy-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "purpose": "Bind one documentation-truth dispatch plan and model turn to the exact Local Storage receipt that proves one signed runtime grant was consumed atomically with its route-bound lease.",
  "baseCompiler": "scripts/compile-codex-documentation-truth-dispatch.mjs",
  "baseRunner": "scripts/run-codex-documentation-truth-dispatch.mjs",
  "workerClass": "documentation-truth",
  "workClass": "capability-manifest-maintenance",
  "acceptedLeaseReceiptKind": "evavo-autonomous-work-exchange-lease-effect-receipt-v2",
  "acceptedDispatchPlanKind": "evavo-codex-documentation-truth-dispatch-plan-v1",
  "acceptedRunReceiptKind": "evavo-codex-documentation-truth-run-v1",
  "maximumInputBytes": 8388608,
  "maximumOutputBytes": 8388608,
  "compilerTimeoutSeconds": 120,
  "runnerTimeoutSeconds": 1500,
  "requiredGrantTruth": {
    "runtimeGrantVerificationPerformed": true,
    "grantConsumed": true,
    "grantConsumptionRecorded": true,
    "grantConsumedUses": 1,
    "grantRemainingUses": 0
  },
  "modelExecutionAuthority": false,
  "deterministicValidationAuthority": false,
  "repositoryMutationAuthority": false,
  "commitAuthority": false,
  "pushAuthority": false,
  "publicationAuthority": false,
  "deploymentAuthority": false,
  "financialActionAuthority": false,
  "paidFallbackAllowed": false,
  "truthBoundary": "The compiler is read-only. The runner may invoke only the existing physically accepted documentation-truth runner after revalidating exact lease-receipt bytes and grant-consumption continuity. It cannot mint or reuse a grant, renew a lease, validate a candidate, commit, push, publish, deploy, perform a financial action or use paid capacity."
}
