{
  "schemaVersion": 1,
  "kind": "evavo-autonomous-spark-task-registry-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "purpose": "Expose reviewed Spark capacity, route-bound lease, exact-bound Test Builder and documentation-truth source contracts while keeping physical worker admission, scheduling, deterministic validation and publication separate.",
  "tasks": {
    "spark-capacity-source-contract-suite": {
      "runtime": "node-script",
      "entry": "scripts/run-codex-spark-capacity-contract-suite.mjs",
      "network": "disabled",
      "timeoutSeconds": 900,
      "effect": "read-only-tests"
    },
    "spark-capacity-observation-compile": {
      "runtime": "node-script",
      "entry": "scripts/compile-codex-spark-capacity-observation.mjs",
      "network": "disabled",
      "timeoutSeconds": 120,
      "effect": "read-only-compiler",
      "arguments": [
        "codexOutcomePath"
      ]
    },
    "spark-capacity-status-compile": {
      "runtime": "node-script",
      "entry": "scripts/compile-codex-spark-capacity-status.mjs",
      "network": "disabled",
      "timeoutSeconds": 180,
      "effect": "read-only-compiler",
      "arguments": [
        "capacityObservationPath",
        "codexCapabilityPath",
        "chatgptAuthPolicyPath",
        "optionalSupervisedAcceptancePath"
      ]
    },
    "spark-admitted-route-plan": {
      "runtime": "node-script",
      "entry": "scripts/plan-codex-spark-admitted-route.mjs",
      "network": "disabled",
      "timeoutSeconds": 120,
      "effect": "read-only-planner",
      "arguments": [
        "readyWorkItemPath",
        "capacityStatusPath"
      ]
    },
    "codex-worker-capability-probe": {
      "runtime": "node-script",
      "entry": "scripts/probe-codex-worker-adapter.mjs",
      "network": "disabled",
      "timeoutSeconds": 60,
      "effect": "read-only-probe"
    },
    "codex-chatgpt-auth-policy-probe": {
      "runtime": "node-script",
      "entry": "scripts/probe-codex-chatgpt-auth-policy.mjs",
      "network": "disabled",
      "timeoutSeconds": 60,
      "effect": "read-only-probe"
    },
    "autonomous-work-exchange-lease-plan-v2": {
      "runtime": "node-script",
      "entry": "scripts/compile-autonomous-work-exchange-lease-plan.mjs",
      "network": "disabled",
      "timeoutSeconds": 60,
      "effect": "read-only-planner"
    },
    "autonomous-work-exchange-lease-runner-v2": {
      "runtime": "node-script",
      "entry": "scripts/run-autonomous-work-exchange-lease.mjs",
      "network": "disabled",
      "timeoutSeconds": 180,
      "effect": "canonical-local-storage-lease"
    },
    "test-builder-bound-dispatch-compile": {
      "runtime": "node-script",
      "entry": "scripts/compile-codex-worker-dispatch-bound.mjs",
      "network": "disabled",
      "timeoutSeconds": 120,
      "effect": "read-only-compiler",
      "arguments": [
        "leasedWorkItemPath",
        "routePlanPath",
        "codexCapabilityPath",
        "candidateWorktreeReceiptPath",
        "workerId"
      ]
    },
    "test-builder-exact-completion-compile": {
      "runtime": "node-script",
      "entry": "scripts/compile-codex-test-builder-completion.mjs",
      "network": "disabled",
      "timeoutSeconds": 180,
      "effect": "read-only-candidate-observer-compiler",
      "arguments": [
        "leasedWorkItemPath",
        "routePlanPath",
        "boundDispatchPlanPath",
        "runReceiptPath"
      ]
    },
    "test-builder-exact-bound-contract-suite": {
      "runtime": "node-script",
      "entry": "scripts/check-codex-candidate-observation-contract.mjs",
      "network": "disabled",
      "timeoutSeconds": 900,
      "effect": "read-only-tests"
    },
    "documentation-truth-dispatch-compile": {
      "runtime": "node-script",
      "entry": "scripts/compile-codex-documentation-truth-dispatch.mjs",
      "network": "disabled",
      "timeoutSeconds": 120,
      "effect": "read-only-compiler"
    },
    "documentation-truth-physical-acceptance-verify": {
      "runtime": "node-script",
      "entry": "scripts/verify-codex-documentation-truth-physical-acceptance.mjs",
      "network": "disabled",
      "timeoutSeconds": 120,
      "effect": "read-only-verifier"
    },
    "documentation-truth-run": {
      "runtime": "node-script",
      "entry": "scripts/run-codex-documentation-truth-dispatch.mjs",
      "network": "disabled-by-worker-contract",
      "timeoutSeconds": 1200,
      "effect": "guarded-candidate-worktree-model-run",
      "routineSchedulingAllowed": false,
      "requiresDedicatedPhysicalAcceptance": true
    },
    "documentation-truth-contract-suite": {
      "runtime": "node-script",
      "entry": "scripts/check-autonomous-work-exchange-lease-contract.mjs",
      "network": "disabled",
      "timeoutSeconds": 900,
      "effect": "read-only-tests"
    }
  },
  "physicalCodexExecutionRegistered": false,
  "normalSparkExecutionRequiresSupervisedPhysicalAcceptance": true,
  "initialWorkerClasses": [
    "test-generation"
  ],
  "sourceReadyWorkerClasses": [
    "test-generation",
    "documentation-truth"
  ],
  "testBuilderBoundDispatchCompilerRegistered": true,
  "testBuilderExactCandidateObserverRegistered": true,
  "testBuilderExactCompletionCompilerRegistered": true,
  "testBuilderDeterministicValidationRegistered": false,
  "testBuilderCommitOrPublicationRegistered": false,
  "documentationTruthLeaseSourceRegistered": true,
  "documentationTruthDispatchCompilerRegistered": true,
  "documentationTruthPhysicalAcceptanceVerifierRegistered": true,
  "documentationTruthRunnerSourceRegistered": true,
  "documentationTruthWorkerRoutePhysicallyAdmitted": false,
  "documentationTruthSupervisedPhysicalAcceptanceRecorded": false,
  "documentationTruthCapacityStatusAdmitted": false,
  "documentationTruthNormalExecutionRegistered": false,
  "documentationTruthAutomaticSchedulingEnabled": false,
  "initialMaximumConcurrency": 1,
  "paidFallbackAllowed": false,
  "deterministicValidationAuthority": false,
  "publicationAuthority": false,
  "deploymentAuthority": false,
  "truthBoundary": "The Test Builder source lane now has an exact-bound dispatch compiler, stable two-pass candidate observer and exact-bound pre-validation completion compiler, but physical execution remains separately gated and deterministic validation, commit, push, publication and deployment remain unregistered. The documentation-truth source lane remains physically inactive. A checked-in compiler, verifier or runner is not acceptance."
}
