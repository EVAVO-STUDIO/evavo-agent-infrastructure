{
  "schemaVersion": 1,
  "kind": "evavo-provider-database-routing-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "clients": ["chatgpt-pro", "claude-code", "codex", "api-agent"],
  "observedState": "EVAVO-STUDIO/evavo-development-studio:config/observed-platform-capabilities-v1.json",
  "routing": {
    "supabase": {
      "authority": "Development Studio Supabase connector",
      "production": true,
      "state": "read-diagnostic-sql-read-proven",
      "mutation": "reviewed provider migration/branch plus postcondition"
    },
    "firebase": {
      "authority": "Local Compute Firebase adapter",
      "production": true,
      "state": "provider-auth-proven-cli-15.28.1-current-project-inventory-proven"
    },
    "cloudinary": {
      "authority": "Cloudinary provider connector",
      "production": true,
      "state": "provider-read-write-delete-lifecycle-proven"
    },
    "cloudflare": {
      "authority": "Development Studio Provider Transport then Local Compute Wrangler",
      "production": true,
      "state": "provider-read-authority-proven-local-write-authority-observed-state-required"
    },
    "neon-postgres": {
      "authority": "Neon connected provider",
      "production": true,
      "state": "project-admin-visibility-proven-sql-wrapper-blocked"
    },
    "mongodb": {
      "authority": "Local Compute",
      "production": false,
      "state": "mongo8-docker-write-read-proven-mongosh-2.10.0-installed-external-profile-pending",
      "developmentRoute": "database sandbox registry"
    },
    "postgresql-sandbox": {
      "authority": "Local Compute",
      "production": false,
      "state": "postgres17-docker-write-read-proven"
    },
    "redis": {"authority":"Local Compute","production":false,"state":"redis7-docker-write-read-proven"},
    "mysql": {"authority":"Local Compute","production":false,"state":"mysql84-docker-write-read-proven"},
    "mariadb": {"authority":"Local Compute","production":false,"state":"mariadb11-docker-write-read-proven"},
    "sqlite": {"authority":"Local Compute","production":false,"state":"python-stdlib-write-read-proven"},
    "duckdb": {"authority":"Local Compute","production":false,"state":"duckdb-1.5.1-disposable-venv-write-read-proven"}
  },
  "sources": {
    "observedState": "EVAVO-STUDIO/evavo-development-studio:config/observed-platform-capabilities-v1.json",
    "connectorCatalog": "EVAVO-STUDIO/evavo-development-studio:config/agent-automation-connectors.json",
    "providerCapabilityPlane": "EVAVO-STUDIO/evavo-development-studio:config/agent-cloud-provider-capability-plane.json",
    "brainDatabaseRouting": "EVAVO-STUDIO/the-brain:config/database-provider-routing-v1.json",
    "databaseSandboxRegistry": "EVAVO-STUDIO/evavo-local-compute:config/database-sandbox-registry-v1.json",
    "physicalExecutionAdmission": "EVAVO-STUDIO/the-brain:config/windows-physical-execution-admission-v1.json"
  },
  "rules": {
    "providerNativeFirst": true,
    "observedStateWinsOnConflict": true,
    "productionDdlRequiresMigrationOrBranch": true,
    "unknownSchemaChangesUseSandboxFirst": true,
    "databaseIdentityRequiredBeforeEffects": true,
    "destructiveEffectsRequireSeparateLease": true,
    "credentialValuesReturned": false,
    "blindRetryAfterUnknownWrite": false,
    "livePhysicalStatusRequiredForLocalDatabaseEffects": true,
    "providerNativeReadOnlyMayContinueWhenWindowsExecutionIsDegraded": true
  }
}
