{
  "schemaVersion": 1,
  "kind": "evavo-codex-documentation-truth-dispatch-policy-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "purpose": "Compile one physically admitted documentation-truth Codex invocation for an exact leased capability-manifest maintenance item in an isolated candidate worktree.",
  "workerClass": "documentation-truth",
  "workClass": "capability-manifest-maintenance",
  "category": "capability-manifest-gap",
  "routeId": "codex-spark-pro",
  "modelPreference": "gpt-5.3-codex-spark",
  "capacityClass": "included-consumer",
  "canonicalAllowedPaths": ["evavo.capabilities.json", ".evavo/capabilities.json"],
  "maximumChangedFiles": 1,
  "maximumChangedLines": 600,
  "maximumAutomaticAttempts": 1,
  "maximumPromptBytes": 131072,
  "resultStates": ["SUCCESS", "NO_ACTION", "BLOCKED", "NEEDS_DEEP_WORKER", "NEEDS_HUMAN"],
  "resultFields": ["resultState", "changedPaths", "capabilitiesDeclared", "authorityDeclared", "evidenceUsed", "assumptions", "followUp"],
  "requiresFreshPhysicalRouteAdmission": true,
  "requiresExactLeaseEvidence": true,
  "requiresCandidateWorktree": true,
  "requiresCurrentHeadMatch": true,
  "networkAccessExpected": false,
  "paidFallbackAllowed": false,
  "deterministicValidationAuthority": false,
  "commitAuthority": false,
  "pushAuthority": false,
  "publicationAuthority": false,
  "deploymentAuthority": false,
  "truthBoundary": "The compiled plan can authorize one future model invocation only after the effectful runner independently verifies the same short-lived route admission, documentation-truth physical acceptance, capability bytes, candidate HEAD and clean workspace. The compiler itself performs no model turn or mutation."
}
