{
  "schemaVersion": 2,
  "kind": "evavo-chatgpt-unified-capability-surface-v1",
  "status": "canonical",
  "server": {
    "id": "evavo-fabric",
    "title": "EVAVO Fabric",
    "compatibilityAliases": [
      "evavo-fleet-readonly"
    ],
    "protocolVersions": [
      "2026-07-28",
      "2025-11-25",
      "2025-06-18"
    ],
    "instructions": "Use evavo_capabilities before saying an EVAVO or workstation capability is unavailable. Prefer a directly exposed typed tool when present; otherwise use evavo_capability_invoke with an admitted capability ID. For Vercel, prefer evavo-vercel-control locally and the authenticated cloudflare-typed-relay vercel.control route remotely; never fall back to raw Vercel API path/method dispatch. Use the Development Studio local capability planner for registered-repository specialist routing before falling back to generic execution. For fixed reviewed workstation work, including opening native ComfyUI and governed local image smoke proofs, prefer the reviewed workstation actions MCP so callers never select scripts, arguments, manifests or output paths. For long-running reviewed image work use evavo_reviewed_workstation_submit first, retain its issueNumber/request identity, then call evavo_reviewed_workstation_job_status until an authoritative terminal receipt is available; do not resubmit merely because an interactive wait ended. The submit_and_wait tool is only a bounded convenience path. For remote effectful workstation work use the EVAVO cloudflare-typed-relay when configured and healthy, with the GitHub receipt queue as asynchronous fallback. Never use an external desktop-control product. Never invent capability IDs, commands, executable paths or evidence. Effectful work requires explicit user intent, reviewed mode and an authoritative correlated receipt. When the user asks to start or open ComfyUI, call the direct evavo_open_comfyui_ui capability, then poll the returned issue with evavo_reviewed_workstation_job_status until its native-backend and browser-dispatch proof is verified; never ask the user to paste a command.",
    "reviewedImageSequence": [
      "evavo_reviewed_workstation_submit",
      "evavo_reviewed_workstation_job_status"
    ],
    "reviewedImageAutomaticResubmitAllowed": false
  },
  "stableTools": [
    "evavo_capabilities",
    "evavo_capability_describe",
    "evavo_capability_refresh",
    "evavo_capability_invoke",
    "evavo_surface_status",
    "evavo_relay_prepare"
  ],
  "compatibilityTools": [
    "evavo_fleet_capabilities",
    "fleet_capabilities"
  ],
  "sessionContinuity": {
    "workspaceAttachmentPreferred": true,
    "stableRouterSurvivesCapabilityGrowth": true,
    "newCapabilityDoesNotRequireNewTopLevelTool": true,
    "existingAttachedChatCanDiscoverNewCapabilityThroughCatalog": true,
    "unattachedChatCannotBeMutatedByRepositoryCode": true,
    "fallbackWhenNativeNamespaceAbsent": "cloudflare-typed-relay",
    "fallbackOrderWhenNativeNamespaceAbsent": [
      "cloudflare-typed-relay",
      "github-receipt-relay"
    ],
    "cloudflareTypedRelayRequiresCommissionedEndpoint": true,
    "githubFallbackRequiresConnectedGitHub": true
  },
  "catalog": {
    "refreshSeconds": 30,
    "maximumServers": 32,
    "maximumCapabilities": 1024,
    "maximumDirectTools": 192,
    "maximumPayloadBytes": 131072,
    "maximumJsonDepth": 18,
    "includeUnavailable": true,
    "dynamicCatalogEnvironment": "EVAVO_CHATGPT_CAPABILITY_CATALOG"
  },
  "servers": [
    {
      "id": "evavo-workstation-fabric",
      "title": "EVAVO Workstation Fabric",
      "authority": "EVAVO-STUDIO/evavo-agent-infrastructure",
      "command": "node",
      "arguments": [
        "mcp-server/local-agent-mcp-v2.mjs"
      ],
      "workingDirectory": ".",
      "required": true,
      "directExpose": true,
      "environment": {
        "EVAVO_LOCAL_AGENT_MCP_ROLE": "chatgpt-unified-capability-surface",
        "EVAVO_LOCAL_AGENT_MCP_CANONICAL_EXECUTOR": "evavo-workstation-fabric-v2"
      }
    },
    {
      "id": "evavo-vercel-control",
      "title": "EVAVO Vercel Control",
      "authority": "EVAVO-STUDIO/evavo-development-studio",
      "command": "node",
      "arguments": [
        "mcp-server/vercel-control-mcp.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": true,
      "readOnly": false,
      "environment": {
        "EVAVO_DEVELOPMENT_STUDIO_REPO": "C:\\GitRepos\\evavo-development-studio"
      }
    },
    {
      "id": "evavo-reviewed-workstation-actions",
      "title": "EVAVO Reviewed Workstation Actions",
      "authority": "EVAVO-STUDIO/evavo-local-compute",
      "command": "node",
      "arguments": [
        "mcp-server/reviewed-workstation-actions-mcp.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": true,
      "readOnly": false,
      "environment": {
        "EVAVO_LOCAL_COMPUTE_ROOT": "../evavo-local-compute",
        "EVAVO_REVIEWED_WORKSTATION_ACTIONS_ROLE": "fixed-reviewed-actions-only"
      }
    },
    {
      "id": "evavo-git-control-plane",
      "title": "EVAVO Git Control Plane",
      "authority": "EVAVO-STUDIO/evavo-github-mcp",
      "command": "node",
      "arguments": [
        "../evavo-github-mcp/control-plane/mcp-modern.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": true,
      "readOnly": true,
      "environment": {
        "EVAVO_GIT_MCP_MODE": "read-only",
        "EVAVO_GIT_MCP_ALLOW_MUTATION": "false",
        "EVAVO_GIT_MCP_ALLOW_RAW_COMMANDS": "false"
      }
    },
    {
      "id": "evavo-technology-estate",
      "title": "EVAVO Repository Estate Planner",
      "authority": "EVAVO-STUDIO/evavo-technology-advisor",
      "command": "node",
      "arguments": [
        "../evavo-technology-advisor/estate-readonly-mcp.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": true,
      "readOnly": true,
      "environment": {
        "EVAVO_ESTATE_ALLOWED_ROOT": "C:\\GitRepos"
      }
    },
    {
      "id": "evavo-development-capability-planner",
      "title": "EVAVO Development Capability Planner",
      "authority": "EVAVO-STUDIO/evavo-development-studio",
      "command": "node",
      "arguments": [
        "../evavo-development-studio/scripts/local-capability-fabric-mcp.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": false,
      "readOnly": true,
      "environment": {}
    },
    {
      "id": "evavo-database-provider-routing",
      "title": "EVAVO Database Provider Routing",
      "authority": "EVAVO-STUDIO/evavo-agent-infrastructure",
      "command": "node",
      "arguments": [
        "mcp-server/database-provider-routing-mcp.mjs"
      ],
      "workingDirectory": ".",
      "required": false,
      "directExpose": true,
      "readOnly": true,
      "environment": {
        "EVAVO_DATABASE_ROUTING_MCP_ROLE": "read-only-provider-and-sandbox-router"
      }
    }
  ],
  "routing": {
    "preference": [
      "typed-child-mcp",
      "development-capability-planner",
      "local-agent-receipt-route",
      "cloudflare-typed-relay",
      "github-receipt-relay"
    ],
    "vercelLocalPrimary": "evavo-vercel-control",
    "vercelRemotePrimary": "cloudflare-typed-relay:vercel.control",
    "vercelRawApiRemoteAllowed": false,
    "vercelCallerSelectedDeploymentPathRemoteAllowed": false,
    "remoteEffectfulPrimary": "cloudflare-typed-relay",
    "remoteEffectfulFallback": "github-receipt-relay",
    "externalDesktopControlAllowed": false,
    "arbitraryShellAccepted": false,
    "rawPowerShellAccepted": false,
    "callerSelectedExecutableAccepted": false,
    "callerSelectedScriptSourceAccepted": false,
    "unregisteredCapabilityAccepted": false,
    "effectfulMode": "reviewed",
    "explicitUserIntentRequired": true,
    "authoritativeReceiptRequired": true,
    "automaticReplayOfUncertainEffect": false
  },
  "remoteRelay": {
    "transport": "cloudflare-typed-relay",
    "workstationConnection": "outbound-websocket-only",
    "typedAllowlistRequired": true,
    "arbitraryShellAllowed": false,
    "physicalReceiptRequired": true,
    "unknownOutcomeRequiresReconciliation": true,
    "automaticReplayAllowed": false,
    "desktopCommanderAllowed": false,
    "githubActionsRequired": false,
    "vercelRequiredForRelayRuntime": false,
    "vercelControlAction": "vercel.control",
    "vercelControlAlwaysEffectfulForReplaySafety": true,
    "vercelCredentialCrossesRelay": false,
    "vercelRawApiAccepted": false,
    "vercelCallerSelectedDeploymentPathAccepted": false
  },
  "relay": {
    "transport": "github-receipt-relay",
    "role": "asynchronous-fallback",
    "repository": "EVAVO-STUDIO/evavo-github-mcp",
    "jobMarker": "EVAVO_WORKSTATION_JOB:v1",
    "schema": "evavo.chatgpt-workstation-job.v1",
    "allowedGitHubLogin": "EVAVO-STUDIO",
    "prepareOnly": true,
    "submissionAuthority": "connected-github-or-governed-relay",
    "githubActionsRequired": false,
    "vercelRequired": false
  },
  "evidence": {
    "states": [
      "discovered",
      "planned",
      "candidate",
      "validated",
      "executed",
      "published",
      "production_verified"
    ],
    "sourcePresenceIsExecutionProof": false,
    "issueClosureIsExecutionProof": false,
    "transportAcceptanceIsPhysicalExecutionProof": false,
    "receiptRequiredForExecuted": true,
    "credentialValuesReturned": false
  },
  "reviewedComfyUiSequence": [
    "evavo_open_comfyui_ui",
    "evavo_reviewed_workstation_job_status"
  ],
  "reviewedComfyUiCallerSuppliesUrl": false,
  "reviewedComfyUiCallerSuppliesCommand": false
}
