{
  "schemaVersion": 1,
  "kind": "evavo-documentation-truth-runtime-activation-verifier-policy-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "grantBodyKind": "evavo-documentation-truth-runtime-activation-grant-v1",
  "grantEnvelopeKind": "evavo-documentation-truth-runtime-activation-grant-envelope-v1",
  "grantRequestKind": "evavo-documentation-truth-runtime-grant-request-v1",
  "trustAnchorKind": "evavo-documentation-truth-runtime-activation-trust-anchor-v1",
  "verificationReceiptKind": "evavo-documentation-truth-runtime-activation-grant-verification-v1",
  "signatureAlgorithm": "Ed25519",
  "signatureVersion": "evavo_documentation_truth_runtime_activation_ed25519_v1",
  "workerClass": "documentation-truth",
  "workClass": "capability-manifest-maintenance",
  "routeId": "codex-spark-pro",
  "capacityClass": "included-consumer",
  "maximumGrantLifetimeSeconds": 900,
  "maximumUses": 1,
  "maximumConcurrency": 1,
  "privateKeyAccepted": false,
  "privateKeyStoredInRepository": false,
  "trustAnchorStoredInRepository": false,
  "requiredInputs": [
    "exact unsigned grant request bytes",
    "exact externally signed grant envelope bytes",
    "external public-key trust anchor bytes",
    "verification time",
    "durable consumed-use count"
  ],
  "authority": {
    "signatureCreation": false,
    "grantConsumption": false,
    "capacitySelection": false,
    "queueMutation": false,
    "lease": false,
    "modelExecution": false,
    "repositoryMutation": false,
    "commit": false,
    "push": false,
    "publication": false,
    "deployment": false,
    "financial": false,
    "paidFallback": false
  },
  "rule": "The verifier is covered by the exact Agent Infrastructure main SHA signed into the grant. It may verify one signed envelope against one exact request and external public key, but it cannot sign, consume, lease, route or execute."
}
