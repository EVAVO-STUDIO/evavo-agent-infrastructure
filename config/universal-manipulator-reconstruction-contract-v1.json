    "reviewedEnrollmentRequired": true,
    "exactTargetAndBindingRequired": true,
    "checkedInConnectorManifestRequired": true,
    "exactConnectorSourceRevisionRequired": true,
    "exactManifestFingerprintRequired": true,
    "exactOperationGrantRequired": true,
    "grantWideningRequiresNewReview": true,
    "machineLocalTrustSealRequired": true,
    "commandIntentReservationRequiredBeforeExecution": true,
    "nonceReuseAllowed": false,
    "idempotencyKeyReuseAllowed": false,
    "sealedInterlockRequiredBeforeMutation": true,
    "unknownOutcomeBlocksRetry": true,
    "automaticResumeAuthorized": false,
