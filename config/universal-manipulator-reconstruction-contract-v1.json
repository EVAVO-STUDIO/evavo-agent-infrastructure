    "operationCatalog": "EVAVO-STUDIO/evavo-workstation-manager:config/device-control-operation-catalog-v1.json"
  },
  "recoveryTruth": {
    "historicalLocalCheckout": "C:\\GitRepos\\universal-manipulator",
    "historicalRemoteState": "unresolved-404-in-prior-review",
