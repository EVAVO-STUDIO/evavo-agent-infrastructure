  "plannedConnectorFamilies": [
    {
      "connectorId": "home-assistant-local",
      "mode": "local-aggregation",
      "constraints": [
        "fixed-service-allowlists-only",
        "no-generic-service-call-passthrough",
        "readback-required-for-effectful-operations"
      ]
    },
    {
