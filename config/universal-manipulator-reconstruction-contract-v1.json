      "mode": "typed-local-adapters",
      "candidateProtocols": [
        "mdns-http",
        "http-json",
        "https-json",
        "mqtt",
        "ble-gatt-profiled",
        "serial-profiled"
      ],
      "constraints": [
        "protocol-observation-before-selection",
        "generated-drivers-start-sandboxed",
        "exact-device-readback-before-promotion"
      ]
    }
  ],
  "requiredCommandLifecycle": [
