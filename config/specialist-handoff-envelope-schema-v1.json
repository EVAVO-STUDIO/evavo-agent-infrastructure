{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evavo.local/schemas/specialist-handoff-envelope-v1.json",
  "title": "EVAVO Specialist Handoff Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "handoffId",
    "objective",
    "from",
    "to",
    "requestedCapability",
    "requestedEffect",
    "authority",
    "inputs",
    "constraints",
    "expectedOutputs",
    "acceptanceCriteria",
    "evidence",
    "executionAuthority"
  ],
  "properties": {
    "contractVersion": {"const": "evavo_specialist_handoff_v1"},
    "handoffId": {"type": "string", "minLength": 8, "maxLength": 160},
    "correlationId": {"type": ["string", "null"], "maxLength": 160},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialist", "repository"],
      "properties": {
        "specialist": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]+$"},
        "sourceRevision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40})?$"}
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialist", "repository"],
      "properties": {
        "specialist": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]+$"},
        "sourceRevision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40})?$"}
      }
    },
    "requestedCapability": {"type": "string", "minLength": 1, "maxLength": 240},
    "requestedEffect": {"enum": ["read", "write", "execute", "control", "publish"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "authorityRepository", "validated"],
      "properties": {
        "authorityId": {"type": "string", "minLength": 1},
        "authorityRepository": {"type": "string", "pattern": "^EVAVO-STUDIO/[A-Za-z0-9._-]+$"},
        "validated": {"type": "boolean"},
        "routeId": {"type": ["string", "null"]},
        "strategyId": {"type": ["string", "null"]},
        "minimumState": {"type": ["string", "null"]}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})?$"},
          "description": {"type": ["string", "null"], "maxLength": 2000}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceReferences", "requiredReceipts"],
      "properties": {
        "sourceReferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "requiredReceipts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "priorReceiptReferences": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "executionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantedByEnvelope", "requiresIndependentAdmission"],
      "properties": {
        "grantedByEnvelope": {"const": false},
        "requiresIndependentAdmission": {"const": true}
      }
    }
  }
}
