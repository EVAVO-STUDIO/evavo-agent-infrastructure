{
  "schemaVersion": 1,
  "kind": "evavo-codex-documentation-truth-physical-acceptance-policy-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "purpose": "Temporarily admit the documentation-truth Codex worker only after a supervised fixture proves truthful capability-manifest maintenance, useful NO_ACTION, path rejection, deterministic validation, cleanup and unchanged primary checkout.",
  "routeId": "codex-spark-pro",
  "modelPreference": "gpt-5.3-codex-spark",
  "capacityClass": "included-consumer",
  "requiredAuthenticationClass": "chatgpt-consumer",
  "sandboxMode": "workspace-write",
  "approvalPolicy": "never",
  "workerClasses": ["documentation-truth"],
  "maximumConcurrency": 1,
  "maximumAcceptanceAgeHours": 168,
  "maximumCapabilityAgeSeconds": 600,
  "maximumFutureClockSkewSeconds": 120,
  "paidFallbackAllowed": false,
  "requiredEvidence": [
    "fresh-codex-capability-probe",
    "chatgpt-auth-policy-probe",
    "documentation-truth-fixture-work-item",
    "isolated-candidate-receipt",
    "documentation-truth-run-receipt",
    "success-path-candidate-audit",
    "no-action-path-receipt",
    "path-boundary-rejection-receipt",
    "current-head-mismatch-rejection-receipt",
    "deterministic-validation-evidence",
    "primary-checkout-unchanged-attestation",
    "candidate-cleanup-attestation"
  ],
  "requiredTruth": {
    "fixtureOnly": true,
    "modelTurnCompleted": true,
    "structuredTurnCompleted": true,
    "successPathProven": true,
    "noActionPathProven": true,
    "pathBoundaryRejectionProven": true,
    "currentHeadMismatchRejectionProven": true,
    "authenticationClass": "chatgpt-consumer",
    "authPolicyAccepted": true,
    "apiKeyEnvironmentAbsent": true,
    "paidFallbackUsed": false,
    "candidateAuditAccepted": true,
    "deterministicValidationPassed": true,
    "primaryCheckoutUnchanged": true,
    "workerCommitPerformed": false,
    "publicationPerformed": false,
    "deploymentPerformed": false,
    "cleanupComplete": true
  },
  "invalidateOn": [
    "codex-version-change",
    "adapter-byte-change",
    "documentation-truth-dispatch-policy-change",
    "worker-route-config-change",
    "sandbox-policy-change",
    "authentication-class-change",
    "fixture-evidence-mismatch"
  ],
  "truthBoundary": "This policy can admit only one documentation-truth worker at concurrency one. It grants no deterministic-validation, commit, push, publication, deployment, external communication, machine-control or paid-fallback authority. No checked-in policy file is itself an acceptance receipt."
}
