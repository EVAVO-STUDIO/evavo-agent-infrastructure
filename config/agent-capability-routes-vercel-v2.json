{
  "schemaVersion": 2,
  "kind": "evavo-vercel-capability-routes-v2",
  "authority": "development-governance",
  "providerControlMustSurviveWorkstationOutage": true,
  "automaticFallbackAfterUncertainMutation": false,
  "routes": [
    {
      "capability": "vercel.inspect",
      "preferred": "vercel-provider-cloud-mcp",
      "fallbacks": ["official-vercel-connector", "vercel-local-control-mcp", "workstation-typed-relay"],
      "workstationRequired": false
    },
    {
      "capability": "vercel.configure",
      "preferred": "vercel-provider-cloud-mcp",
      "fallbacks": ["vercel-local-control-mcp", "workstation-typed-relay"],
      "workstationRequired": false,
      "writeRequiresReason": true
    },
    {
      "capability": "vercel.deploy",
      "preferred": "vercel-provider-cloud-mcp",
      "fallbacks": ["official-vercel-connector-when-operation-exposed", "vercel-local-control-mcp", "workstation-typed-relay"],
      "workstationRequired": false,
      "gitDeploymentPreferred": true
    },
    {
      "capability": "vercel.domain-dns",
      "preferred": "vercel-provider-cloud-mcp",
      "fallbacks": ["vercel-local-control-mcp", "workstation-typed-relay"],
      "workstationRequired": false,
      "externalRegistrarMutationImplied": false,
      "exactProviderDnsPlanRequired": true
    },
    {
      "capability": "workstation.execute",
      "preferred": "workstation-typed-relay",
      "fallbacks": ["local-queue-control-resident", "local-queue-normal-resident"],
      "workstationRequired": true,
      "vercelProviderControlAllowedAsDependency": false
    }
  ]
}
