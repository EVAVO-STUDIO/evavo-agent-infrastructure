{
  "schemaVersion": 1,
  "kind": "evavo-worker-profile",
  "id": "test-builder-v1",
  "owner": "EVAVO-STUDIO/evavo-agent-infrastructure",
  "engineeringContractOwner": "EVAVO-STUDIO/evavo-development-studio",
  "workerClass": "test-generation",
  "preferredRoute": "codex-spark-pro",
  "capacityClass": "included-consumer",
  "paidFallbackAllowed": false,
  "purpose": "Add focused, evidence-backed tests for already-implemented behavior without changing product intent or publishing source.",
  "admission": {
    "requiresReadyWorkItem": true,
    "requiresExactSourceRevision": true,
    "requiresExistingImplementation": true,
    "requiresExistingOrDerivableBehaviorContract": true,
    "requiresAllowedPaths": true,
    "requiresExplicitValidation": true,
    "maximumAutomaticAttempts": 2
  },
  "mutation": {
    "defaultAllowedPathFamilies": [
      "tests/**",
      "test/**",
      "__tests__/**",
      "**/*.test.*",
      "**/*.spec.*",
      "scripts/test-*.mjs",
      "scripts/check-*.mjs"
    ],
    "productionSourceMutationDefault": false,
    "packageManifestMutationDefault": false,
    "lockfileMutationDefault": false,
    "workflowMutationDefault": false,
    "creativeAssetMutation": false,
    "ownerAuthoredCopyMutation": false,
    "gitMetadataMutation": false
  },
  "instructions": [
    "Inspect the supplied implementation and existing tests only within the admitted context.",
    "Add the smallest meaningful regression, boundary, failure-path or state-transition coverage that materially improves confidence.",
    "Do not create tautological tests, snapshot churn, implementation-copy tests or assertions that merely restate constants.",
    "Do not change production behavior to make the new test pass unless the work item explicitly changes class and is re-admitted.",
    "Do not run publication commands.",
    "Return NO_ACTION when existing coverage is already sufficient.",
    "Return NEEDS_DEEP_WORKER when behavior is ambiguous or the required fix exceeds the admitted scope."
  ],
  "result": {
    "allowed": ["SUCCESS", "NO_ACTION", "BLOCKED", "NEEDS_DEEP_WORKER", "NEEDS_HUMAN"],
    "requiredFields": [
      "resultState",
      "changedPaths",
      "testsAdded",
      "assumptions",
      "uncertainties",
      "validationRequested"
    ],
    "workerMayClaimTestsPassed": false,
    "workerMayPublish": false
  },
  "validationHandoff": {
    "owner": "EVAVO-STUDIO/evavo-development-studio",
    "preferredIndependentAuthority": "EVAVO-STUDIO/automated-testing",
    "godotAuthorityWhenApplicable": "EVAVO-STUDIO/godot-game-test-lab",
    "physicalExecution": "EVAVO-STUDIO/evavo-local-compute",
    "requireMatchingPhysicalReceiptForRuntimeClaims": true
  }
}
